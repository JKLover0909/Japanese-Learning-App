# Copy to .env for local configuration; never commit .env.
# All application settings use the JP_ prefix.

# SQLAlchemy database URL. Relative SQLite paths resolve from backend/ when running locally.
JP_DATABASE_URL=sqlite:///../data/app.db

# Learners practise anonymously: each browser gets an HttpOnly cookie and its own progress.
# Learner registration and login are disabled; no learner account settings are needed.

# Admin statistics page (/admin). Do not type the password here. Run
#   backend/.venv/bin/python backend/scripts/set_admin_password.py
# which prompts for it and writes only the Argon2 hash into .env (mode 600).
# Admin login stays disabled (HTTP 503) while either value is empty.
JP_ADMIN_USERNAME=
JP_ADMIN_PASSWORD_HASH=

# Cookie security mode: auto (follow request scheme), true, or false.
JP_COOKIE_SECURE=auto

# Lesson JSON source directory.
JP_CONTENT_DIR=../backend/app/content/lessons

# Built frontend directory served by FastAPI.
JP_FRONTEND_DIST=../frontend/dist

# Apply pending Alembic migrations at application startup.
JP_AUTO_MIGRATE=true

# Number of questions per round and maximum weak-item focus slots.
JP_SESSION_SIZE=20
JP_FOCUS_SIZE=5
